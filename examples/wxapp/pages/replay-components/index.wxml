<view class="replay-page" data-sentry-replay-unmask="true">
  <view class="replay-header">
    <view class="title-line">
      <text class="replay-title">看看操作前后</text>
      <text class="experiment-label">实验性</text>
    </view>
    <text class="replay-description">{{localMode ? '本地验证模式：录制保存在内存，导出后在本地播放器查看，不上传 Sentry。' : '在这里录制操作，到 Sentry 查看页面回放与关联错误。'}}</text>
  </view>

  <view class="controls">
    <view class="state-line"><text class="state-label">当前页面</text><text class="state-value">{{changed ? '订单已确认' : '等待确认订单'}}</text></view>
    <view class="action-grid">
      <button class="action-button primary" hover-class="button-pressed" bindtap="onChange">{{changed ? '恢复初始状态' : '确认订单'}}</button>
      <button class="action-button secondary" hover-class="button-pressed" bindtap="onToggle">打开确认弹窗</button>
    </view>
  </view>

  <view class="section-heading"><text class="section-name">组件里的内容</text><text class="section-note">试着滚动列表</text></view>
  <replay-card class="preview-card" wx:for="{{items}}" wx:key="*this" title="{{item}}" updated="{{changed}}" data-sentry-replay-mask="{{masked && index === 0}}">
    <text slot="footer" class="slot-note">页面插槽 · {{changed ? '状态同步更新' : '等待操作'}}</text>
  </replay-card>

  <view class="privacy-section">
    <view class="privacy-title-line"><text class="section-name">隐私也可以验证</text><switch checked="{{masked}}" color="#6C5FC7" bindchange="onMask" aria-label="遮蔽第一张卡片的文字" /></view>
    <text class="help-text">开启后，第一张卡片及内部组件的文字都会遮蔽。</text>
    <input class="demo-input" value="{{privateInput}}" bindinput="onInput" placeholder="输入测试文字，回放只显示占位" placeholder-class="input-placeholder" aria-label="隐私验证输入框" />
    <text class="input-note">不要输入真实账号、手机号或其它个人信息。</text>
  </view>

  <view class="verification" data-sentry-replay-block="true">
    <view class="section-heading"><text class="section-name">{{localMode ? '查看本地录制' : '把这次操作带到 Sentry'}}</text><text class="recorder-state {{recording ? 'is-recording' : ''}}">{{recording ? '录制中' : '未录制'}}</text></view>
    <text class="help-text">{{localMode ? '最多保留 20 段、1 MiB；复制 JSON 后粘贴到本地播放器。退出小程序后内存记录会丢失。' : '录制状态和发送回执只代表客户端结果，实际播放请到 Sentry 查看。'}}</text>
    <view wx:if="{{notice}}" class="notice {{failed ? 'notice-error' : ''}}"><text>{{notice}}</text></view>
    <button class="submit-button" hover-class="button-pressed" loading="{{busy}}" disabled="{{busy || !recording}}" bindtap="onCaptureError">{{localMode ? '关联测试错误并本地保存' : '关联错误并发送回放'}}</button>
    <button wx:if="{{localMode}}" class="action-button secondary" hover-class="button-pressed" disabled="{{busy}}" bindtap="onExportLocal">复制录制 JSON</button>
    <view class="secondary-actions"><button class="text-button" hover-class="button-pressed" bindtap="onRestart">重新录制</button><button class="text-button" hover-class="button-pressed" disabled="{{!recording}}" bindtap="onStop">停止录制</button></view>
    <text wx:if="{{lastEventId}}" class="event-reference" selectable>错误 ID · {{lastEventId}}</text>
  </view>

  <view wx:if="{{modal}}" class="modal-mask" catchtap="onCloseModal">
    <view class="replay-dialog" catchtap="onDialogTap">
      <text class="dialog-title">确认这次操作？</text>
      <text class="dialog-description">这个弹窗用于观察节点出现、遮罩层与页面状态的变化。</text>
      <button class="action-button primary" hover-class="button-pressed" bindtap="onConfirmModal">确认并关闭</button>
      <button class="text-button dialog-cancel" hover-class="button-pressed" bindtap="onCloseModal">返回页面</button>
    </view>
  </view>
</view>
