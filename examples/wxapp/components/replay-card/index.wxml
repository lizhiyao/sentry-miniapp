<view class="replay-card">
  <view class="card-heading"><text class="card-title">{{title}}</text><text class="card-status">{{updated ? '已更新' : '待处理'}}</text></view>
  <scroll-view scroll-y class="replay-scroll" scroll-top="{{scrollTop}}" bindscroll="onScroll">
    <replay-row wx:for="{{rows}}" wx:key="*this" text="{{item}}" updated="{{updated}}" />
  </scroll-view>
  <slot name="footer" />
</view>
